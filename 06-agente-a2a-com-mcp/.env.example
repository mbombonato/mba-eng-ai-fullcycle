# Copie para .env (na raiz do repositorio) e preencha. O .env esta no .gitignore.
# Gere a chave com:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Minimo de 32 bytes de aleatoriedade (64 caracteres hex). Nunca versione o valor real.
REQUEST_STATE_SECRET=

# Opcionais (os valores abaixo sao os padroes)
