# MCP_PORT=7301
# AGENTE_HOST=127.0.0.1
# AGENTE_PORT=7300
# AGENTE_URL_PUBLICA=http://127.0.0.1:7300
# MCP_URL=http://127.0.0.1:7301/mcp
