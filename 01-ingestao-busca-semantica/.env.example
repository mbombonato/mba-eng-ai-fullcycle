# Provedor dos modelos: "openai" (padrão) ou "gemini"
LLM_PROVIDER=openai

# OpenAI — https://platform.openai.com/docs/models
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5.4-nano

# Gemini — https://ai.google.dev/gemini-api/docs/models
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# Banco de dados (Postgres + pgVector do docker-compose)
# Se mudar POSTGRES_PORT, ajuste a porta em DATABASE_URL também.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=document_chunks

# PDF a ser ingerido (relativo à raiz do projeto)
PDF_PATH=document.pdf
