# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# AI Gateway (LiteLLM). A master key e o banco são só do gateway.
LITELLM_MASTER_KEY=sk-gateway-master-0001
GATEWAY_DB_PASSWORD=litellm-local-0001
# Chaves virtuais que a aplicação usa para falar com o gateway (criadas no boot do
# gateway a partir de gateway/keys.json). Não são chaves de provider.
GATEWAY_REALTIME_KEY=sk-helpdesk-realtime-0001
GATEWAY_REPORTS_KEY=sk-helpdesk-reports-0001
