# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Modelo Gemini de todos os agentes (padrão: gemini-3.6-flash)
AURORA_MODELO=
# Opcional: modelos diferentes para o agente principal e para os especialistas
AURORA_MODELO_PRINCIPAL=
AURORA_MODELO_ESPECIALISTAS=
# Opcional: pasta dos bancos SQLite (padrão: ./var) e porta da API (padrão: 8000)
AURORA_VAR_DIR=
AURORA_PORT=
# Opcional (validação local, fora do exigido pelo desafio): provedor alternativo.
# Com AURORA_PROVEDOR=openai, instale o extra (uv sync --extra openai) e use
# AURORA_MODELO=openai/gpt-4.1-mini (padrão nesse modo).
AURORA_PROVEDOR=
OPENAI_API_KEY=
